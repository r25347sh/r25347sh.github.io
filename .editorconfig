# EditorConfig for r25347sh projects (multiquiz / github.io)
# Human-readable, consistent formatting

root = true

# ------------------------------------------------------------------------------
# 1. 全ファイル共通のデフォルト設定
# ------------------------------------------------------------------------------
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

# ------------------------------------------------------------------------------
# 2. 言語・ファイル形式ごとの個別上書き設定
# ------------------------------------------------------------------------------
[*.{js,html,css,json}]
max_line_length = 100

# 設定の重複（charsetやend_of_line等）をスッキリ削除。Grokで抽出した独自拡張子（myext, myapp）も念のため追加
[*.{multiquiz,mq,myext,myapp}]

[*.md]
trim_trailing_whitespace = false

# ライブラリフォルダ（lib/）配下のすべてのファイルを対象にするため「**」に修正
[lib/**]
trim_trailing_whitespace = false

# EditorConfig for r25347sh projects (multiquiz / github.io)
# Human-readable, consistent formatting

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off
indent_style = space
indent_size = 2

[*.{js,html,css,json}]
indent_style = space
indent_size = 2
max_line_length = 100

[*.{multiquiz,mq}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
charset = utf-8
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[lib/**]
trim_trailing_whitespace = false
